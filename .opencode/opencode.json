{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "allow",
    "bash": {
      "git push *": "ask",
      "git commit *": "ask",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git branch *": "allow",
      "git add *": "allow",
      "git stash *": "allow",
      "rm -rf .venv*": "deny",
      "rm -rf *": "deny",
      "ruff check*": "allow",
      "ruff format*": "allow",
      "pytest*": "allow",
      "pip install*": "allow",
      "python -m build*": "allow",
      "mkdocs*": "allow",
      "h2iso *": "allow",
      "*": "allow"
    },
    "external_directory": {
      "/home/gw/opt/tricys/**": "allow",
      "/home/gw/opt/h2iso/.venv/**": "allow",
      "/home/gw/projects/h2iso/**": "allow"
    }
  },
  "agent": {
    "h2iso-dev": {
      "description": "Primary agent for h2iso hydrogen isotope thermodynamics development. Handles VLE property kernels, CasADi MESH solver, equilibrator, flowsheet, codegen, and CLI.",
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": { "*": "allow" }
      }
    },
    "h2iso-test": {
      "description": "Test runner for h2iso. Runs pytest (unit/property/benchmark/e2e), ruff lint/format, and validates VLE/MESH simulation outputs.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "pytest*": "allow",
          "ruff check*": "allow",
          "ruff format*": "allow",
          "pip install*": "allow",
          "*": "ask"
        }
      }
    }
  }
}
